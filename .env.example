# Database Connection URL (MySQL / MariaDB / TiDB)
# Run `docker compose up -d` to launch a local MySQL instance with these credentials:
DATABASE_URL=mysql://root:rootpassword@localhost:3306/smart_gate

# Application Port
PORT=3000

# Session Secret (change in production)
JWT_SECRET=smart-gate-super-secret-key-32-chars-min!
VITE_APP_ID=smart-gate-access-system

# Device & Admin Default
OWNER_OPEN_ID=demo-admin

# Allowed Origins for CORS/WebSocket (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
